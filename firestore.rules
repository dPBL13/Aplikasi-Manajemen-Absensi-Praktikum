rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fungsi pembantu untuk memeriksa autentikasi
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // `exists()` mencegah error ketika dokumen profil belum sempat dibuat
    // (mis. registrasi baru). Tanpa guard ini, `get(...).data.role` melempar
    // error dan seluruh aturan write ikut ditolak.
    function isAsprak() {
      return isAuthenticated()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'asprak';
    }

    // Koleksi Profil Pengguna
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAsprak());
      allow delete: if isAsprak();
      
      // Token FCM perangkat (BR-09): hanya pemilik akun yang boleh baca/tulis.
      match /fcmTokens/{tokenId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Koleksi Laboratorium (Sprint 3, FR-29 / JH-01)
    match /laboratories/{labId} {
      allow read: if true; // Praktikan dan Asprak dapat melihat lokasi laboratorium
      allow write: if isAuthenticated();
    }

    // Koleksi Kelas Praktikum (FR-05)
    match /classes/{classId} {
      allow read: if true; // Praktikan dan Asprak dapat melihat kelas
      allow write: if isAuthenticated();
    }

    // Koleksi Sesi Praktikum (FR-07, FR-08, FR-10)
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, delete: if isAuthenticated();
      // Asprak dapat mengubah status sesi, Praktikan dapat mencatat checkInAt
      allow update: if isAuthenticated();
    }

    // Koleksi Pengajuan Izin (FR-16 s/d FR-20)
    match /permits/{permitId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Asprak dapat mengubah status keputusan izin
      allow update: if isAuthenticated();
      allow delete: if isAsprak();
    }
  }
}
